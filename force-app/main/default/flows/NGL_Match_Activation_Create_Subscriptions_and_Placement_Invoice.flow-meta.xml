<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This is the most important billing flow. It fires once when a match is fully executed and creates three financial records simultaneously: the Senior Host subscription invoice, the Renter subscription invoice, and the one-time Property Placement Fee invoice.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaPlacementFee</name>
        <dataType>Number</dataType>
        <expression>({!Get_Related_Housing_Unit.Market_Rent_ZIP__c} - {!Get_Related_Housing_Unit.Effective_Renter_Rent__c}) * 0.15</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>NGL — Match Activation — Create Subscriptions and Placement Invoice {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NGL — Match Activation — Create Subscriptions and Placement Invoice</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_First_Month_Waiver</name>
        <label>Create First Month Waiver</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Renter_Invoice_Set_Credit_Applied</targetReference>
        </connector>
        <inputAssignments>
            <field>Amount__c</field>
            <value>
                <numberValue>89.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Applied_Invoice__c</field>
            <value>
                <elementReference>varRenterInvoiceId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Generated__c</field>
            <value>
                <numberValue>89.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Type__c</field>
            <value>
                <stringValue>First Month Waiver</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Match__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Credit_Memo__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Placement_Fee_Invoice</name>
        <label>Create Placement Fee Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Match_Status</targetReference>
        </connector>
        <inputAssignments>
            <field>Base_Amount__c</field>
            <value>
                <elementReference>formulaPlacementFee</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Billed_Contact__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Type__c</field>
            <value>
                <stringValue>Placement Fee</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Match__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Sent</stringValue>
            </value>
        </inputAssignments>
        <object>Invoice__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Renter_Invoice</name>
        <label>Create Renter Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>varRenterInvoiceId</assignRecordIdToReference>
        <connector>
            <targetReference>Create_First_Month_Waiver</targetReference>
        </connector>
        <inputAssignments>
            <field>Base_Amount__c</field>
            <value>
                <numberValue>89.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Billed_Contact__c</field>
            <value>
                <elementReference>$Record.Young_Renter__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Billing_Period_Start__c</field>
            <value>
                <elementReference>$Record.Move_In_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Date__c</field>
            <value>
                <elementReference>$Record.Move_In_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Type__c</field>
            <value>
                <stringValue>Monthly Subscription</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Match__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <object>Invoice__c</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Senior_Host_Invoice</name>
        <label>Create Senior Host Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Renter_Invoice</targetReference>
        </connector>
        <inputAssignments>
            <field>Base_Amount__c</field>
            <value>
                <numberValue>149.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Billed_Contact__c</field>
            <value>
                <elementReference>$Record.Senior_Host__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Billing_Period_Start__c</field>
            <value>
                <elementReference>$Record.Move_In_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Date__c</field>
            <value>
                <elementReference>$Record.Move_In_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Type__c</field>
            <value>
                <stringValue>Monthly Subscription</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Match__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <object>Invoice__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Related_Housing_Unit</name>
        <label>Get Related Housing Unit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Senior_Host_Invoice</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Housing_Unit__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Housing_Unit__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Match_Status</name>
        <label>Update Match Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Renter_Invoice_Set_Credit_Applied</name>
        <label>Update Renter Invoice — Set Credit Applied</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Placement_Fee_Invoice</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRenterInvoiceId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Credit_Applied__c</field>
            <value>
                <numberValue>89.0</numberValue>
            </value>
        </inputAssignments>
        <object>Invoice__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Housing_Unit</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Agreement_Signed__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Match__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varRenterInvoiceId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
